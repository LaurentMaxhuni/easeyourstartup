# Public application URL. Use an exact origin without a trailing slash.
DEPLOYMENT_ENVIRONMENT=staging
EASEYOURSTARTUP_TEST_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# AI provider. Campaign generation and AI editing require a working provider;
# provider failures preserve saved work and surface a retryable error.
AI_GENERATION_ENABLED=true
# Campaign generation stays on V1 unless explicitly opted into V2.
GENERATION_VERSION=v1
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL. For Groq use:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# Leave blank to use the provider default.
OPENAI_MODEL=
# Provider alias priority: NVIDIA NIM, OpenRouter, Groq, then OPENAI_*.
# Optional explicit selection: nvidia-nim, openrouter, groq, or openai.
AI_PROVIDER=
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter's free router is the easiest no-cost alternative:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OpenRouter uses this comma-separated fallback list when a model fails.
# Defaults to openrouter/free when unset. After the daily free quota is reached,
# free fallbacks are skipped; set a model your account can access to continue.
# OPENROUTER_FALLBACK_MODELS=openrouter/free
# NVIDIA NIM supports hosted or self-hosted OpenAI-compatible endpoints.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=

# Optional per-task overrides. Provider-specific values win over AI_* values.
# Supported suffixes: BRAND_VISION, BRAND_TEXT, STRATEGY, COPY, DESIGN_PLANNER, CRITIC.
# OPENROUTER_STRATEGY_MODEL=anthropic/claude-...
# NVIDIA_NIM_BRAND_VISION_MODEL=<image-capable-nim-model>
# NVIDIA_NIM_STRATEGY_MODEL=<nim-model>
# GROQ_STRATEGY_MODEL=openai/gpt-oss-120b
# OPENAI_STRATEGY_MODEL=gpt-5.6-terra
# AI_STRATEGY_MODEL=provider-model

# Browserless managed browser. Live screenshots require both values.
BROWSERLESS_API_URL=https://production-sfo.browserless.io
BROWSERLESS_API_KEY=

# Neon Postgres. Required for accounts, project persistence, billing, and quotas.
DATABASE_URL=
# Optional direct Neon URL for migrations and operator commands.
DATABASE_URL_UNPOOLED=

# Neon Auth. Enable Neon Auth on the Neon branch before setting these values.
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
NEON_AUTH_COOKIE_SECRET=

# Paddle Billing subscriptions. Use sandbox or production.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_PRICE_ID=
# Monthly USD 13.99 recurring price for Pro Lite. Must differ from Pro/founding.
PADDLE_PRO_LITE_PRICE_ID=
PADDLE_FOUNDING_PRICE_ID=
# Annual USD prices: Pro Lite 134.30, Pro 278.40, founding Pro 182.40.
# Provision against the matching monthly products: node scripts/provision-annual-prices.mjs
PADDLE_PRO_LITE_ANNUAL_PRICE_ID=
PADDLE_PRO_ANNUAL_PRICE_ID=
PADDLE_FOUNDING_ANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Local background jobs use `pnpm dev:inngest` and the Inngest Dev Server.
INNGEST_DEV=1
INNGEST_EVENT_KEY=local
# Production Inngest signing key; not needed by the local dev server.
INNGEST_SIGNING_KEY=

# Private S3-compatible object storage for uploaded product screenshots.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI Design Studio providers (server only; separate from campaign provider aliases).
# Full registry schema and safe disabled examples: docs/design-studio-providers.md.
# No provider activates from a key alone. Configure explicit model capabilities.
# A nonempty JSON registry is authoritative; [] intentionally configures none.
DESIGN_AI_PROVIDERS_JSON=
# Optional routing/budget settings; blank uses true / 65536 / 8 respectively.
DESIGN_AI_PREFER_FREE=
DESIGN_AI_MAX_CALL_TOKENS=
DESIGN_AI_MAX_ATTEMPTS=

# Per-provider shorthand is used only when DESIGN_AI_PROVIDERS_JSON is blank.
# Each MODELS_JSON is an explicit array from the guide; no default model is assumed.
HETZNER_API_KEY=
DESIGN_AI_HETZNER_BASE_URL=
DESIGN_AI_HETZNER_MODELS_JSON=
ZAI_API_KEY=
DESIGN_AI_ZAI_BASE_URL=
DESIGN_AI_ZAI_MODELS_JSON=
GEMINI_API_KEY=
DESIGN_AI_GEMINI_BASE_URL=
DESIGN_AI_GEMINI_MODELS_JSON=
GROQ_API_KEY=
DESIGN_AI_GROQ_BASE_URL=
DESIGN_AI_GROQ_MODELS_JSON=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DESIGN_AI_CLOUDFLARE_BASE_URL=
DESIGN_AI_CLOUDFLARE_MODELS_JSON=
OPENROUTER_API_KEY=
DESIGN_AI_OPENROUTER_BASE_URL=
DESIGN_AI_OPENROUTER_MODELS_JSON=
# Optional OpenAI-compatible provider reuses OPENAI_API_KEY defined above.
DESIGN_AI_OPENAI_BASE_URL=
DESIGN_AI_OPENAI_MODELS_JSON=

# Isolated design renderer: local executable or dedicated remote browser CDP URL.
# If both are blank, the renderer derives CDP from existing Browserless settings.
DESIGN_CHROMIUM_EXECUTABLE_PATH=
DESIGN_BROWSER_CDP_URL=
# Optional design job token ceiling and workspace concurrency (default 2, range 1-8).
DESIGN_JOB_TOKEN_BUDGET=
DESIGN_WORKSPACE_CONCURRENCY=
