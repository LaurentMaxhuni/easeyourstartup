# Public application URL. Use an exact origin without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider. The studio requires a live AI provider; it never substitutes a
# local template when a provider is unavailable.
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL. For Groq use:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# Leave blank to use the provider default.
OPENAI_MODEL=
# Optional provider-specific aliases. These take precedence over OPENAI_* when set.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=qwen/qwen3.6-27b
# OpenRouter's free router is the easiest no-cost alternative:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free

# Browserless managed browser. Live screenshots require both values.
BROWSERLESS_API_URL=https://production-sfo.browserless.io
BROWSERLESS_API_KEY=

# Neon Postgres. Demo mode works without this value.
DATABASE_URL=

# Neon Auth. Enable Neon Auth on the Neon branch before setting these values.
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
NEON_AUTH_COOKIE_SECRET=

# Stripe subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Inngest signing keys for durable background jobs.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# HMAC key for signed render payloads. Use at least 32 random bytes.
RENDER_SIGNING_SECRET=
